# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/trading-platform

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Stripe Configuration (for subscription payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email Configuration (optional - for notifications)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@yourplatform.com

# Market Data Configuration (optional)
MARKET_DATA_API_KEY=your-market-data-api-key
MARKET_DATA_URL=https://api.marketdata.com

# Logging Configuration
LOG_LEVEL=info

# Security Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Trading Configuration
DEFAULT_EXECUTION_INTERVAL=60000
MAX_STRATEGIES_PER_USER=10
BACKTEST_ENABLED=true

# Subscription Checker Configuration
SUBSCRIPTION_CHECK_ENABLED=true
RENEWAL_REMINDER_DAYS=7,3,1

# Redis Configuration (optional - for caching)
REDIS_URL=redis://localhost:6379